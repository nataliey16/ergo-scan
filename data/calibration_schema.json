{
  "type": "object",
  "required": ["pixel_metadata", "lengths", "angles", "confidence"],
  "properties": {
    "pixel_metadata": {
      "type": "object",
      "description": "Information needed to convert pixel measurements to real-world CM.",
      "properties": {
        "pixel_height": { "type": "number" },
        "scale_factor_cm_per_pixel": { "type": "number" },
        "image_width": { "type": "number" },
        "image_height": { "type": "number" }
      },
      "required": ["pixel_height", "scale_factor_cm_per_pixel"]
    },

    "lengths": {
      "type": "object",
      "description": "Body segment lengths measured from pixel landmarks, and converted into CM.",
      "properties": {
        "shoulder_width_px": { "type": "number" },
        "shoulder_width_cm": { "type": "number" },

        "upper_arm_length_px": { "type": "number" },
        "upper_arm_length_cm": { "type": "number" },

        "forearm_length_px": { "type": "number" },
        "forearm_length_cm": { "type": "number" },

        "torso_length_px": { "type": "number" },
        "torso_length_cm": { "type": "number" },

        "neck_length_px": { "type": "number" },
        "neck_length_cm": { "type": "number" }
      }
    },

    "angles": {
      "type": "object",
      "description": "Posture angles derived from normalized → pixel landmarks.",
      "properties": {
        "forward_head_angle_deg": { "type": "number" },
        "neck_flexion_deg": { "type": "number" },
        "torso_lean_deg": { "type": "number" },
        "shoulder_angle_deg": { "type": "number" },
        "elbow_angle_deg": { "type": "number" }
      }
    },

    "confidence": {
      "type": "object",
      "description": "Visibility confidence scores (0–1) aggregated from MediaPipe landmark visibilities.",
      "properties": {
        "head_confidence": { "type": "number" },
        "shoulder_confidence": { "type": "number" },
        "torso_confidence": { "type": "number" },
        "arm_confidence": { "type": "number" }
      }
    },

    "debug": {
      "type": "object",
      "description": "Optional debug outputs for visualization or QA.",
      "properties": {
        "used_landmarks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "raw_landmark_positions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "number" }
          }
        }
      }
    }
  }
}
